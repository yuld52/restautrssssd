// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id             String         @id @default(uuid())
  name           String
  slug           String         @unique
  description    String
  avatarImageUrl String
  coverImageUrl  String
  adminPin       String         @default("1234") // PIN exclusivo desta empresa cliente
  isActive       Boolean        @default(true)   // Status da assinatura (ativo/bloqueado)
  plan           String         @default("PRO")  // Plano contratado (BASIC, PRO, ENTERPRISE)
  contactPhone   String?                         // Telefone/WhatsApp da empresa
  contactEmail   String?                         // Email do responsável
  menuCategories MenuCategory[]
  products       Product[]
  orders         Order[]
  waiterCalls    WaiterCall[]
  videoViews     VideoView[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([slug])
}

model MenuCategory {
  id           String     @id @default(uuid())
  name         String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  products     Product[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId])
}

model Product {
  id             String         @id @default(uuid())
  name           String
  description    String
  price          Float
  imageUrl       String
  videoUrl       String?
  ingredients    String[]
  orderProducts  OrderProduct[]
  videoViews     VideoView[]
  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId   String
  menuCategory   MenuCategory   @relation(fields: [menuCategoryId], references: [id], onDelete: Cascade)
  menuCategoryId String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([restaurantId])
  @@index([menuCategoryId])
}

model Order {
  id                Int               @id @default(autoincrement())
  total             Float
  status            OrderStatus
  consumptionMethod ConsumptionMethod
  tableNumber       String?
  restaurant        Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId      String
  orderProducts     OrderProduct[]
  customerName      String
  customerCpf       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([restaurantId])
  @@index([restaurantId, status])
}

model OrderProduct {
  id        String   @id @default(uuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  IN_PREPARATION
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  FINISHED
}

enum ConsumptionMethod {
  TAKEAWAY
  DINE_IN
}

model WaiterCall {
  id           String           @id @default(uuid())
  tableNumber  String
  reason       String           @default("Atendimento na mesa")
  status       WaiterCallStatus @default(PENDING)
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([restaurantId])
  @@index([restaurantId, status])
}

enum WaiterCallStatus {
  PENDING
  ATTENDED
  CANCELLED
}

model VideoView {
  id           String      @id @default(uuid())
  duration     Float
  tableNumber  String?
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String?
  createdAt    DateTime    @default(now())

  @@index([productId])
  @@index([restaurantId])
}